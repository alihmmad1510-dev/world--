        { x:  9, z:  9, w: 13, d: 13, h: [5, 9], house: true }
    ]};
    if (r < 0.86) return { items: [
        { x: -10, z: -11, w: 9, d: 9, h: [5, 8], house: true },
        { x:   0, z: -11, w: 9, d: 9, h: [5, 8], house: true },
        { x:  10, z: -11, w: 9, d: 9, h: [5, 8], house: true },
        { x: -10, z:   0, w: 9, d: 9, h: [5, 8], house: true },
        { x:   0, z:   0, w: 9, d: 9, h: [5, 8], house: true },
        { x:  10, z:   0, w: 9, d: 9, h: [5, 8], house: true }
