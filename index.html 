<!DOCTYPE html>
<html lang="ar" dir="rtl">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0, user-scalable=no">
<title>GTA 6 City — Online</title>
<style>
    * { box-sizing: border-box; }
    html, body {
        margin: 0; height: 100%; overflow: hidden;
        background-color: #111;
        font-family: 'Segoe UI', Arial, sans-serif;
        user-select: none; -webkit-user-select: none;
        -webkit-tap-highlight-color: transparent;
        touch-action: none;
    }
    canvas { display: block; }

    #hud {
        position: absolute; top: 18px; right: 18px;
        z-index: 100; pointer-events: none; text-align: right;
    }
    #hud .title {
        font-size: 22px; font-weight: 800;
        letter-spacing: 1px; color: #ffcc00;
        text-shadow: 0 2px 8px #000; margin: 0;
    }
    #hud .sub {
        font-size: 13px; margin: 4px 0 0;
        color: #fff; text-shadow: 0 2px 6px #000; opacity: .9;
    }

    #clock {
        position: absolute; top: 18px; left: 18px;
        color: #fff; background: rgba(0,0,0,.55);
        border: 1px solid rgba(255,204,0,.4);
        border-radius: 8px; padding: 8px 14px;
        font-weight: 700; font-size: 14px;
        z-index: 100; pointer-events: none;
        text-shadow: 0 2px 6px #000;
        font-variant-numeric: tabular-nums;
    }
    #clock .sun { color: #ffcc00; margin-left: 6px; }

    #net-status {
        position: absolute; top: 62px; left: 18px;
        color: #fff; background: rgba(0,0,0,.6);
        border: 1px solid rgba(60,220,120,.5);
        border-radius: 8px; padding: 6px 12px;
        font-weight: 700; font-size: 12px;
        z-index: 100; pointer-events: none;
        display: none;
    }
    #net-status.show { display: block; }
    #net-status .dot {
        display: inline-block;
        width: 8px; height: 8px;
        border-radius: 50%;
        background: #3cdc78;
        box-shadow: 0 0 8px #3cdc78;
        margin-left: 6px;
        vertical-align: middle;
    }
    #net-status .dot.off { background: #666; box-shadow: none; }

    #crosshair {
        position: absolute; top: 50%; left: 50%;
        width: 5px; height: 5px;
        background: rgba(255,255,255,.85);
        border-radius: 50%; transform: translate(-50%,-50%);
        z-index: 100; pointer-events: none;
    }

    #prompt {
        position: absolute; bottom: 200px; left: 50%;
        transform: translateX(-50%);
        background: rgba(0,0,0,.75);
        border: 2px solid #ffcc00;
        border-radius: 10px; padding: 10px 22px;
        color: #ffcc00; font-weight: 800;
        font-size: 16px; letter-spacing: 1px;
        z-index: 160; pointer-events: none;
        opacity: 0; transition: opacity .2s;
        white-space: nowrap;
    }
    #prompt.show { opacity: 1; }
    #prompt span {
        display: inline-block; background: #ffcc00;
        color: #111; padding: 2px 8px;
        border-radius: 5px; margin: 0 4px; font-size: 14px;
    }

    #joystick {
        position: absolute; bottom: 32px; left: 32px;
        width: 148px; height: 148px;
        border-radius: 50%;
        background: radial-gradient(circle at 50% 45%, rgba(255,255,255,.10), rgba(0,0,0,.45) 70%);
        border: 2px solid rgba(255,204,0,.55);
        box-shadow: 0 0 26px rgba(0,0,0,.65), inset 0 0 34px rgba(0,0,0,.6);
        z-index: 150; touch-action: none; cursor: grab;
    }
    #stick {
        position: absolute; top: 50%; left: 50%;
        width: 64px; height: 64px; border-radius: 50%;
        transform: translate(-50%, -50%);
        background: radial-gradient(circle at 35% 28%, #ffeaa0, #ffc107 55%, #b37700 100%);
        border: 2px solid rgba(255,255,255,.4);
        box-shadow: 0 6px 18px rgba(0,0,0,.65);
        pointer-events: none; will-change: transform;
    }

    #buttons {
        position: absolute; bottom: 32px; right: 32px;
        display: flex; flex-direction: column;
        align-items: flex-end; gap: 16px; z-index: 150;
    }
    .btn {
        min-width: 120px; padding: 16px 22px;
        border-radius: 16px; font-family: inherit;
        font-weight: 900; font-size: 16px;
        letter-spacing: 1.5px; cursor: pointer;
        touch-action: none; user-select: none;
        -webkit-user-select: none;
        border: 2px solid transparent;
        transition: transform .08s ease, box-shadow .2s ease;
        outline: none; display: flex;
        align-items: center; justify-content: center; gap: 8px;
    }
    #btn-enter {
        color: #1a1200;
        background: linear-gradient(180deg, #ffd75e, #ffb300);
        border-color: #ffe9a3;
        box-shadow: 0 8px 24px rgba(255,179,0,.45);
    }
    #btn-enter:active, #btn-enter.pressed {
        transform: scale(.93);
        box-shadow: 0 3px 12px rgba(255,179,0,.7);
    }
    #btn-online {
        color: #d9ffe4;
        background: rgba(16, 38, 24, .85);
        border-color: rgba(60, 220, 120, .7);
    }
    #btn-online.connected {
        border-color: #3cdc78;
        box-shadow: 0 0 24px rgba(60,220,120,.5);
    }
    #btn-online .dot {
        width: 10px; height: 10px; border-radius: 50%;
        background: #3cdc78; box-shadow: 0 0 10px #3cdc78;
    }

    .overlay {
        position: fixed; inset: 0;
        background: radial-gradient(circle at 50% 40%, rgba(20,25,40,.88), rgba(0,0,0,.96));
        display: none; justify-content: center; align-items: center;
        z-index: 500; padding: 16px;
    }
    .overlay.show { display: flex; }
    .panel {
        color: #fff; text-align: center;
        padding: 26px 34px; border-radius: 16px;
        background: rgba(8,8,12,.95);
        max-width: 560px; width: 92%;
        max-height: 90vh; overflow-y: auto;
        box-shadow: 0 0 60px rgba(0,0,0,.7);
    }
    #wardrobe .panel { border: 2px solid #ffcc00; }
    #mp-panel .panel { border: 2px solid #3cdc78; max-width: 440px; }
    #kitchen .panel { border: 2px solid #ff8c42; }
    #games .panel { border: 2px solid #a855f7; }
    #character .panel { border: 2px solid #ff6b9d; }
    .panel h2 { margin: 0 0 6px; font-size: 22px; letter-spacing: 1px; }
    #wardrobe h2 { color: #ffcc00; }
    #mp-panel h2 { color: #3cdc78; }
    #kitchen h2 { color: #ff8c42; }
    #games h2 { color: #a855f7; }
    #character h2 { color: #ff6b9d; }
    .hint { margin: 4px 0 18px; font-size: 13px; color: #9aa4b2; }

    #outfits, #faces, #hairs {
        display: grid; grid-template-columns: repeat(4, 1fr);
        gap: 12px; margin-bottom: 18px;
    }
    .outfit, .face-card, .hair-card {
        background: rgba(255,255,255,.04);
        border: 2px solid rgba(255,255,255,.15);
        border-radius: 12px; padding: 10px 4px;
        cursor: pointer; transition: all .15s;
        display: flex; flex-direction: column;
        align-items: center; gap: 6px;
    }
    .outfit:hover, .face-card:hover, .hair-card:hover {
        background: rgba(255,204,0,.1);
        border-color: rgba(255,204,0,.5);
        transform: translateY(-2px);
    }
    .outfit.active, .face-card.active, .hair-card.active {
        background: rgba(255,204,0,.18);
        border-color: #ffcc00;
        box-shadow: 0 0 16px rgba(255,204,0,.5);
    }
    .outfit .swatches, .face-card .swatches, .hair-card .swatches { display: flex; gap: 4px; }
    .outfit .swatch, .face-card .swatch, .hair-card .swatch {
        width: 22px; height: 22px; border-radius: 50%;
        border: 2px solid rgba(0,0,0,.55);
    }
    .outfit .label, .face-card .label, .hair-card .label {
        font-size: 11px; color: #ddd; font-weight: 600;
    }

    .section-title {
        text-align: right; direction: rtl;
        font-size: 13px; color: #9aa4b2;
        margin: 8px 0 10px; font-weight: 700;
        border-right: 3px solid #ffcc00;
        padding-right: 10px;
    }
    #kitchen .section-title { border-color: #ff8c42; }
    #games .section-title { border-color: #a855f7; }
    #character .section-title { border-color: #ff6b9d; }

    button.primary, button.danger, button.secondary {
        width: 100%; padding: 14px;
        border-radius: 12px; font-family: inherit;
        font-weight: 900; font-size: 15px;
        letter-spacing: 1px; cursor: pointer;
        border: 2px solid transparent;
        transition: transform .08s ease;
        outline: none;
    }
    button.primary {
        background: linear-gradient(180deg, #6ee89c, #3cdc78);
        border-color: #a8f0c4; color: #0a2916;
    }
    button.danger {
        background: rgba(255,60,60,.15);
        border-color: rgba(255,107,107,.5);
        color: #ff8080; margin-top: 12px;
    }
    button.secondary {
        background: rgba(255,255,255,.06);
        border-color: rgba(255,255,255,.15);
        color: #ccc; margin-top: 10px;
    }
    button:active { transform: scale(.96); }

    .dish-grid {
        display: grid; grid-template-columns: repeat(3, 1fr);
        gap: 10px; margin-bottom: 12px;
    }
    .dish-card {
        background: rgba(255,140,66,.08);
        border: 2px solid rgba(255,140,66,.3);
        border-radius: 12px; padding: 12px 6px;
        cursor: pointer; transition: all .15s;
        font-size: 12px; color: #ffcfb0;
        display: flex; flex-direction: column;
        align-items: center; gap: 4px;
    }
    .dish-card:hover {
        background: rgba(255,140,66,.2);
        border-color: #ff8c42;
    }
    .dish-card .icon { font-size: 24px; }

    .game-grid {
        display: grid; grid-template-columns: repeat(2, 1fr);
        gap: 10px; margin-bottom: 12px;
    }
    .game-card {
        background: rgba(168,85,247,.08);
        border: 2px solid rgba(168,85,247,.3);
        border-radius: 12px; padding: 14px 8px;
        cursor: pointer; transition: all .15s;
        font-size: 12px; color: #e0c4ff;
        display: flex; flex-direction: column;
        align-items: center; gap: 6px;
    }
    .game-card:hover {
        background: rgba(168,85,247,.2);
        border-color: #a855f7;
    }
    .game-card .icon { font-size: 28px; }

    #rps-result {
        font-size: 15px; padding: 12px;
        background: rgba(0,0,0,.4);
        border-radius: 10px; margin-top: 10px;
        color: #ffcc00; min-height: 24px;
        display: none;
    }
    #rps-result.show { display: block; }
    #rps-choice {
        display: none; gap: 10px; margin-bottom: 10px;
    }
    #rps-choice.show { display: flex; }
    #rps-choice button {
        flex: 1; padding: 14px;
        border-radius: 10px; font-size: 24px;
        background: rgba(168,85,247,.15);
        border: 2px solid rgba(168,85,247,.4);
        cursor: pointer; transition: all .15s;
        color: #fff;
    }
    #rps-choice button:hover {
        background: rgba(168,85,247,.35);
        border-color: #a855f7;
    }

    #mp-status {
        margin: 8px 0 16px; font-size: 13px;
        padding: 8px 12px; border-radius: 8px;
        background: rgba(0,0,0,.4);
        color: #9aa4b2; border: 1px solid rgba(255,255,255,.08);
    }
    #mp-status.host { color: #ffcc00; border-color: rgba(255,204,0,.35); }
    #mp-status.connected { color: #3cdc78; border-color: rgba(60,220,120,.35); }
    #mp-status.error { color: #ff6b6b; border-color: rgba(255,107,107,.35); }

    .mp-tabs {
        display: flex; gap: 6px; margin-bottom: 12px;
        background: rgba(0,0,0,.35); border-radius: 10px; padding: 4px;
    }
    .mp-tab {
        flex: 1; padding: 10px; border-radius: 8px;
        border: none; background: transparent;
        color: #9aa4b2; font-family: inherit;
        font-weight: 700; font-size: 13px; cursor: pointer;
    }
    .mp-tab.active {
        background: rgba(60,220,120,.2);
        color: #3cdc78;
    }
    .mp-tab-content { padding: 4px; }
    .hint2 { margin: 4px 0 12px; font-size: 12px; color: #9aa4b2; line-height: 1.6; }

    #mp-code-input {
        width: 100%; padding: 12px 14px;
        border-radius: 10px;
        border: 2px solid rgba(60,220,120,.4);
        background: rgba(0,0,0,.6);
        color: #fff; font-size: 20px;
        font-family: 'Courier New', monospace;
        font-weight: 900; letter-spacing: 4px;
        text-align: center; text-transform: uppercase;
        outline: none; margin-bottom: 12px;
        direction: ltr;
    }
    .mp-code-box {
        background: rgba(0,0,0,.5);
        border: 2px dashed rgba(255,204,0,.5);
        border-radius: 12px; padding: 14px;
        margin-bottom: 12px;
    }
    .mp-code-label {
        font-size: 11px; color: #ffcc00;
        letter-spacing: 2px; margin-bottom: 6px;
    }
    .mp-code {
        font-family: 'Courier New', monospace;
        font-size: 34px; font-weight: 900;
        letter-spacing: 6px; color: #ffcc00;
        text-shadow: 0 0 18px rgba(255,204,0,.7);
        margin-bottom: 8px; direction: ltr;
    }
    .mp-copy-btn {
        padding: 6px 14px; border-radius: 8px;
        background: rgba(255,204,0,.15);
        border: 1px solid rgba(255,204,0,.5);
        color: #ffcc00; font-weight: 700;
        font-size: 12px; cursor: pointer;
        font-family: inherit;
    }
    .mp-players {
        font-size: 13px; color: #9aa4b2;
        padding: 10px; margin-top: 4px;
        background: rgba(0,0,0,.3);
        border-radius: 8px;
        text-align: right; direction: rtl;
        max-height: 120px; overflow-y: auto;
    }
    .mp-players b { color: #3cdc78; }

    @media (max-width: 560px) {
        #joystick { width: 124px; height: 124px; bottom: 22px; left: 22px; }
        #stick { width: 54px; height: 54px; }
        #buttons { bottom: 22px; right: 22px; gap: 12px; }
        .btn { min-width: 104px; padding: 14px 16px; font-size: 14px; }
        #outfits, #faces, #hairs { grid-template-columns: repeat(3, 1fr); }
        .mp-code { font-size: 26px; letter-spacing: 4px; }
        .dish-grid { grid-template-columns: repeat(2, 1fr); }
    }
</style>
</head>
<body>

<div id="hud">
    <h1 class="title">المدينة | CITY</h1>
    <p class="sub">فيلا فخمة · جراش · عالم مفتوح · أونلاين</p>
</div>

<div id="clock">00:00 <span class="sun">☀</span></div>
<div id="net-status"><span class="dot off"></span> <span id="net-status-text">غير متصل</span></div>
<div id="crosshair"></div>
<div id="prompt"><span>ENTER</span> <em id="prompt-text">للدخول</em></div>

<div id="joystick"><div id="stick"></div></div>

<div id="buttons">
    <button id="btn-enter" class="btn" type="button">ENTER</button>
    <button id="btn-online" class="btn" type="button"><span class="dot"></span> ONLINE</button>
</div>

<div id="wardrobe" class="overlay">
    <div class="panel">
        <h2>👕 غرفة الملابس</h2>
        <p class="hint">اختر ملابسك المفضلة</p>
        <div id="outfits"></div>
        <button class="primary" id="wardrobe-close" type="button">إغلاق</button>
    </div>
</div>

<div id="kitchen" class="overlay">
    <div class="panel">
        <h2>🍳 المطبخ</h2>
        <p class="hint">اطبخ أطباقك المفضلة</p>
        <div class="section-title">الأطباق</div>
        <div class="dish-grid" id="dish-grid"></div>
        <button class="primary" id="kitchen-close" type="button">إغلاق</button>
    </div>
</div>

<div id="games" class="overlay">
    <div class="panel">
        <h2>🎮 غرفة الألعاب</h2>
        <p class="hint">العب واستمتع</p>
        <div class="section-title">اختر لعبة</div>
        <div class="game-grid" id="game-grid"></div>
        <div id="rps-choice">
            <button data-choice="rock" type="button">✊</button>
            <button data-choice="paper" type="button">✋</button>
            <button data-choice="scissors" type="button">✌️</button>
        </div>
        <div id="rps-result"></div>
        <button class="primary" id="games-close" type="button">إغلاق</button>
    </div>
</div>

<div id="character" class="overlay">
    <div class="panel">
        <h2>✨ غرفة التجميل</h2>
        <p class="hint">غيّر مظهرك</p>
        <div class="section-title">لون البشرة</div>
        <div id="faces"></div>
        <div class="section-title">لون الشعر</div>
        <div id="hairs"></div>
        <button class="primary" id="character-close" type="button">إغلاق</button>
    </div>
</div>

<div id="mp-panel" class="overlay">
    <div class="panel">
        <h2>🌐 اللعب الجماعي</h2>
        <div id="mp-status">غير متصل</div>
        <div id="mp-form">
            <div class="mp-tabs">
                <button class="mp-tab active" data-tab="host" type="button">إنشاء غرفة</button>
                <button class="mp-tab" data-tab="join" type="button">الانضمام</button>
            </div>
            <div id="mp-host-tab" class="mp-tab-content">
                <p class="hint2">أنشئ غرفة وشارك الكود مع أصدقائك.</p>
                <button class="primary" id="mp-create" type="button">إنشاء غرفة جديدة</button>
            </div>
            <div id="mp-join-tab" class="mp-tab-content" style="display:none">
                <p class="hint2">أدخل كود الغرفة (6 أحرف).</p>
                <input id="mp-code-input" type="text" placeholder="ABC123" maxlength="6" autocomplete="off">
                <button class="primary" id="mp-join" type="button">انضمام</button>
            </div>
        </div>
        <div id="mp-room-info" style="display:none">
            <div class="mp-code-box">
                <div class="mp-code-label">كود الغرفة</div>
                <div id="mp-code-display" class="mp-code">------</div>
                <button id="mp-copy" class="mp-copy-btn" type="button">📋 نسخ</button>
            </div>
            <div id="mp-players-list" class="mp-players">لا يوجد لاعبون آخرون بعد</div>
            <button class="danger" id="mp-disconnect" type="button">قطع الاتصال</button>
        </div>
        <button class="secondary" id="mp-close" type="button">إغلاق</button>
    </div>
</div>

<script type="importmap">
{
    "imports": {
        "three": "https://unpkg.com/three@0.160.0/build/three.module.js"
    }
}
</script>

<script type="module">
import * as THREE from 'three';

function detectServer() {
    if (window.GTA6_SERVER_URL) return window.GTA6_SERVER_URL;
    const protocol = location.protocol;
    const hostname = location.hostname;
    const port = location.port;
    if (protocol === 'file:') return 'http://localhost:3000';
    if (port === '' || port === '80' || port === '443' || port === '3000') return location.origin;
    return `${protocol}//${hostname}:3000`;
}
const SERVER_URL = detectServer();
console.log('[ONLINE] Server:', SERVER_URL);

/* ============================================================
   ثوابت
   ============================================================ */
const CELL      = 56;
const ROAD_W    = 16;
const CURB_H    = 0.3;
const TILE      = 8;
const RENDER_R  = 3;

const PARK_BLOCK   = { i: -1, j: -1 };
const DEALER_BLOCK = { i: 0,  j: 0  };
const HOME_BLOCK   = { i: -1, j: 0  };

const HOME_CX = (HOME_BLOCK.i + 0.5) * CELL;   // -28
const HOME_CZ = (HOME_BLOCK.j + 0.5) * CELL;   // 28

/* ---------- الفيلا ---------- */
const VILLA_CX   = HOME_CX + 3;    // -25
const VILLA_CZ   = HOME_CZ - 2;    // 26
const VILLA_W    = 22;
const VILLA_D    = 18;
const VILLA_H1   = 3.2;   // الدور الأول
const VILLA_H2   = 2.8;   // الدور التاني (بصري)

/* ---------- الجراش ---------- */
const GARAGE_CX  = HOME_CX - 14;   // -42
const GARAGE_CZ  = HOME_CZ + 5;    // 33
const GARAGE_W   = 12;
const GARAGE_D   = 12;
const GARAGE_H   = 3.0;

/* ---------- مواقع الماركرز (داخل الفيلا) ---------- */
const HOME_KITCHEN_POS   = new THREE.Vector3(VILLA_CX - 8, CURB_H, VILLA_CZ - 4);
const HOME_GAMES_POS     = new THREE.Vector3(VILLA_CX + 8, CURB_H, VILLA_CZ - 4);
const HOME_CHARACTER_POS = new THREE.Vector3(VILLA_CX - 8, CURB_H, VILLA_CZ + 4);
const HOME_WARDROBE_POS  = new THREE.Vector3(VILLA_CX + 8, CURB_H, VILLA_CZ + 4);

/* ============================================================
   المشهد
   ============================================================ */
const scene = new THREE.Scene();
scene.fog = new THREE.Fog(0xbcd6ea, 150, 470);

const camera = new THREE.PerspectiveCamera(70, innerWidth/innerHeight, 0.1, 3000);

const renderer = new THREE.WebGLRenderer({ antialias: true, powerPreference: 'high-performance' });
renderer.setPixelRatio(Math.min(devicePixelRatio, 2));
renderer.setSize(innerWidth, innerHeight);
renderer.shadowMap.enabled = true;
renderer.shadowMap.type = THREE.PCFSoftShadowMap;
renderer.outputColorSpace = THREE.SRGBColorSpace;
renderer.toneMapping = THREE.ACESFilmicToneMapping;
renderer.toneMappingExposure = 1.05;
document.body.appendChild(renderer.domElement);

const MAX_ANISO = renderer.capabilities.getMaxAnisotropy();

/* ============================================================
   أدوات
   ============================================================ */
function makeCanvas(size, draw) {
    const c = document.createElement('canvas');
    c.width = c.height = size;
    draw(c.getContext('2d'), size);
    return c;
}
function texFromCanvas(canvas, rx=1, ry=1, srgb=true) {
    const t = new THREE.CanvasTexture(canvas);
    t.wrapS = t.wrapT = THREE.RepeatWrapping;
    if (srgb) t.colorSpace = THREE.SRGBColorSpace;
    t.repeat.set(rx, ry);
    t.anisotropy = MAX_ANISO;
    return t;
}
function noise(ctx, size, count, alpha, maxVal) {
    for (let i = 0; i < count; i++) {
        const g = Math.floor(Math.random()*maxVal);
        ctx.fillStyle = `rgba(${g},${g},${g+6},${alpha})`;
        ctx.fillRect(Math.random()*size, Math.random()*size, 2, 2);
    }
}

function makeRoadTexture() {
    const S = 256;
    const c = makeCanvas(S, (ctx) => {
        ctx.fillStyle = '#2c2c31'; ctx.fillRect(0,0,S,S);
        noise(ctx, S, 5000, 0.22, 70);
        ctx.fillStyle = 'rgba(228,228,215,0.72)';
        ctx.fillRect(0, 9, S, 5);
        ctx.fillRect(0, S-14, S, 5);
        ctx.fillStyle = 'rgba(245,205,90,0.92)';
        ctx.fillRect(0, S/2-4, S*0.52, 8);
    });
    return texFromCanvas(c);
}
function makeIntersectionTexture() {
    const S = 256;
    const c = makeCanvas(S, (ctx) => {
        ctx.fillStyle = '#2c2c31'; ctx.fillRect(0,0,S,S);
        noise(ctx, S, 4000, 0.22, 70);
        const M = 8, BAND = 44, STRIPE = 13, GAP = 26;
        ctx.fillStyle = 'rgba(235,235,225,0.82)';
        for (let x = M; x < S - M - STRIPE + 1; x += GAP) {
            ctx.fillRect(x, M, STRIPE, BAND);
            ctx.fillRect(x, S-M-BAND, STRIPE, BAND);
        }
        for (let y = M+BAND+GAP; y < S-M-BAND-GAP+1; y += GAP) {
            ctx.fillRect(M, y, BAND, STRIPE);
            ctx.fillRect(S-M-BAND, y, BAND, STRIPE);
        }
    });
    return texFromCanvas(c);
}
function makeFacadeTextures(litProb = 0.42) {
    const S = 256, COLS = 4, ROWS = 4;
    const lit = [];
    for (let i = 0; i < COLS*ROWS; i++) lit.push(Math.random() < litProb);
    const cw = S/COLS, ch = S/ROWS;
    const colorCanvas = makeCanvas(S, (ctx) => {
        ctx.fillStyle = '#0a0a0e'; ctx.fillRect(0,0,S,S);
        noise(ctx, S, 2600, 0.35, 22);
        for (let j = 0; j < ROWS; j++) for (let i = 0; i < COLS; i++) {
            const isLit = lit[j*COLS+i];
            const wx = i*cw + cw*0.20, wy = j*ch + ch*0.16;
            const ww = cw*0.60, wh = ch*0.62;
            ctx.fillStyle = 'rgba(46,48,56,0.9)';
            ctx.fillRect(wx-3, wy-3, ww+6, wh+6);
            ctx.fillStyle = isLit ? '#ffd38c' : '#0c1420';
            ctx.fillRect(wx, wy, ww, wh);
        }
    });
    const emissiveCanvas = makeCanvas(S, (ctx) => {
        ctx.fillStyle = '#000'; ctx.fillRect(0,0,S,S);
        for (let j = 0; j < ROWS; j++) for (let i = 0; i < COLS; i++) {
            if (!lit[j*COLS+i]) continue;
            const wx = i*cw + cw*0.20, wy = j*ch + ch*0.16;
            const ww = cw*0.60, wh = ch*0.62;
            ctx.fillStyle = '#ffc568';
            ctx.fillRect(wx, wy, ww, wh);
        }
    });
    return { map: texFromCanvas(colorCanvas), emissiveMap: texFromCanvas(emissiveCanvas) };
}
function makeHouseTextures(litProb = 0.65) {
    const S = 256, COLS = 2, ROWS = 3;
    const lit = [];
    for (let i = 0; i < COLS*ROWS; i++) lit.push(Math.random() < litProb);
    const cw = S/COLS, ch = S/ROWS;
    const colorCanvas = makeCanvas(S, (ctx) => {
        ctx.fillStyle = '#8a5238'; ctx.fillRect(0,0,S,S);
        const bw = 32, bh = 16;
        for (let y = 0; y < S; y += bh) {
            const off = ((y/bh) % 2 === 0) ? 0 : bw/2;
            for (let x = -off; x < S; x += bw) {
                const shade = 0.85 + Math.random()*0.25;
                ctx.fillStyle = `rgb(${Math.floor(120*shade)},${Math.floor(65*shade)},${Math.floor(45*shade)})`;
                ctx.fillRect(x+1, y+1, bw-2, bh-2);
            }
        }
        for (let j = 0; j < ROWS; j++) for (let i = 0; i < COLS; i++) {
            const isLit = lit[j*COLS+i];
            const wx = i*cw + cw*0.18, wy = j*ch + ch*0.18;
            const ww = cw*0.64, wh = ch*0.60;
            ctx.fillStyle = '#3a2410';
            ctx.fillRect(wx-4, wy-4, ww+8, wh+8);
            ctx.fillStyle = isLit ? '#ffd38c' : '#1a2028';
            ctx.fillRect(wx, wy, ww, wh);
        }
    });
    const emissiveCanvas = makeCanvas(S, (ctx) => {
        ctx.fillStyle = '#000'; ctx.fillRect(0,0,S,S);
        for (let j = 0; j < ROWS; j++) for (let i = 0; i < COLS; i++) {
            if (!lit[j*COLS+i]) continue;
            const wx = i*cw + cw*0.18, wy = j*ch + ch*0.18;
            const ww = cw*0.64, wh = ch*0.60;
            ctx.fillStyle = '#ffc568';
            ctx.fillRect(wx, wy, ww, wh);
        }
    });
    return { map: texFromCanvas(colorCanvas), emissiveMap: texFromCanvas(emissiveCanvas) };
}
function makeConcreteTexture() {
    const S = 256;
    const c = makeCanvas(S, (ctx) => {
        ctx.fillStyle = '#8e8e88'; ctx.fillRect(0,0,S,S);
        noise(ctx, S, 6000, 0.25, 190);
    });
    return texFromCanvas(c, 10, 10);
}
function makeGrassTexture() {
    const S = 256;
    const c = makeCanvas(S, (ctx) => {
        ctx.fillStyle = '#3f7a35'; ctx.fillRect(0,0,S,S);
        for (let i = 0; i < 9000; i++) {
            const g = 60 + Math.random()*90;
            ctx.fillStyle = `rgba(${30+Math.random()*40},${g},${25+Math.random()*35},0.6)`;
            ctx.fillRect(Math.random()*S, Math.random()*S, 2, 3);
        }
    });
    return texFromCanvas(c, 8, 8);
}

