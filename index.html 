function assignCarPath(car) {
    const pi = Math.round(player.position.x / CELL);
    const pj = Math.round(player.position.z / CELL);
    const useHorizontal = Math.random() < 0.5;
    const dir = Math.random() < 0.5 ? 1 : -1;

    if (useHorizontal) {
        const jOff = Math.floor(Math.random() * (RENDER_R*2+3)) - RENDER_R - 1;
        const lineZ = (pj + jOff) * CELL + (dir > 0 ? 4 : -4);
        const xStart = (pi - RENDER_R - 2) * CELL;
        const xEnd = (pi + RENDER_R + 2) * CELL;
        car.userData = {
            axis: 'x', dir,
            pos: dir > 0 ? xStart : xEnd,
            speed: 14 + Math.random() * 12,
            minPos: Math.min(xStart, xEnd),
            maxPos: Math.max(xStart, xEnd)
        };
        car.position.set(car.userData.pos, 0.02, lineZ);
        car.rotation.y = dir > 0 ? Math.PI/2 : -Math.PI/2;
    } else {
        const iOff = Math.floor(Math.random() * (RENDER_R*2+3)) - RENDER_R - 1;
        const lineX = (pi + iOff) * CELL + (dir > 0 ? -4 : 4);
        const zStart = (pj - RENDER_R - 2) * CELL;
        const zEnd = (pj + RENDER_R + 2) * CELL;
        car.userData = {
            axis: 'z', dir,
            pos: dir > 0 ? zStart : zEnd,
            speed: 14 + Math.random() * 12,
            minPos: Math.min(zStart, zEnd),
            maxPos: Math.max(zStart, zEnd)
        };
        car.position.set(lineX, 0.02, car.userData.pos);
        car.rotation.y = dir > 0 ? 0 : Math.PI;
    }
}

