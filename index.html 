function distance2D(a, b) {
    const dx = a.x - b.x, dz = a.z - b.z;
    return Math.sqrt(dx*dx + dz*dz);
}
function nearPlayerCar()  { return distance2D(player.position, playerCar.position) < 4; }
function nearKitchen()    { return distance2D(player.position, HOME_KITCHEN_POS) < 2.5; }
function nearGames()      { return distance2D(player.position, HOME_GAMES_POS) < 2.5; }
function nearCharacter()  { return distance2D(player.position, HOME_CHARACTER_POS) < 2.5; }
function nearWardrobe()   { return distance2D(player.position, HOME_WARDROBE_POS) < 2.5; }

function onEnterPressed() {
    if (activePanel) { closeAllPanels(); return; }
    if (inCar) { exitCar(); return; }
    if (nearKitchen())   { openPanel('kitchen'); return; }
    if (nearGames())     { openPanel('games'); return; }
    if (nearCharacter()) { openPanel('character'); return; }
    if (nearWardrobe())  { openPanel('wardrobe'); return; }
    if (nearPlayerCar()) { enterCar(); return; }
    if (isGrounded) { yVel = JUMP_V; isGrounded = false; }
}
function enterCar() {
    inCar = true;
    player.visible = false;
    carState.heading = playerCar.rotation.y;
    carState.speed = 0;
    broadcastState();
}
function exitCar() {
    inCar = false;
    player.visible = true;
    const h = carState.heading;
    const leftX = Math.cos(h), leftZ = -Math.sin(h);
    const exitX = playerCar.position.x + leftX * 2.2;
    const exitZ = playerCar.position.z + leftZ * 2.2;
    const exitY = groundHeightAt(exitX, exitZ);
    player.position.set(exitX, exitY, exitZ);
    player.rotation.y = h;
    yaw = h + Math.PI;
    broadcastState();
}

