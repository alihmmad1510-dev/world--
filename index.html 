function createRemotePlayer(pid, shirtColor, pantsColor) {
    const sM = new THREE.MeshStandardMaterial({ color: shirtColor, roughness: 0.75 });
    const pM = new THREE.MeshStandardMaterial({ color: pantsColor, roughness: 0.95 });
    const skM = new THREE.MeshStandardMaterial({ color: 0xd8a87c, roughness: 0.85 });
    const haM = new THREE.MeshStandardMaterial({ color: 0x221812, roughness: 1.0 });
    const eyM = new THREE.MeshBasicMaterial({ color: 0x1a1a1a });
    const group = buildCharacterMesh(sM, pM, skM, haM, eyM);
    group.position.set(0, CURB_H, 0);
    scene.add(group);
    const rp = {
        group,
        targetPos: new THREE.Vector3(),
        currentPos: new THREE.Vector3(),
        targetRot: 0,
        currentRot: 0,
        inCar: false
    };
    mp.remotePlayers.set(pid, rp);
    return rp;
}

