function genIntersection(i, j) {
    const key = `x_${i}_${j}`;
    if (generatedIntersections.has(key)) return;
    const m = new THREE.Mesh(new THREE.PlaneGeometry(ROAD_W, ROAD_W), intersectionMat);
    m.rotation.x = -Math.PI / 2;
    m.position.set(i*CELL, 0.025, j*CELL);
    m.receiveShadow = true;
    scene.add(m);
    generatedIntersections.set(key, { mesh: m });
}
function genRoadH(i, j) {
    const key = `h_${i}_${j}`;
    if (generatedRoads.has(key)) return;
    const x1 = i*CELL + ROAD_W/2;
    const x2 = (i+1)*CELL - ROAD_W/2;
    const len = x2 - x1;
    if (len <= 1) return;
    const tex = roadTex.clone();
    tex.needsUpdate = true;
    tex.repeat.set(len / 16, 1);
    tex.anisotropy = MAX_ANISO;
    const mat = new THREE.MeshStandardMaterial({ map: tex, roughness: 0.95 });
    const m = new THREE.Mesh(new THREE.PlaneGeometry(len, ROAD_W), mat);
    m.rotation.x = -Math.PI / 2;
    m.position.set((x1+x2)/2, 0.02, j*CELL);
    m.receiveShadow = true;
    scene.add(m);
    generatedRoads.set(key, { mesh: m });
}
function genRoadV(i, j) {
    const key = `v_${i}_${j}`;
    if (generatedRoads.has(key)) return;
    const z1 = j*CELL + ROAD_W/2;
    const z2 = (j+1)*CELL - ROAD_W/2;
    const len = z2 - z1;
    if (len <= 1) return;
    const tex = roadTex.clone();
    tex.needsUpdate = true;
    tex.repeat.set(len / 16, 1);
    tex.anisotropy = MAX_ANISO;
    const mat = new THREE.MeshStandardMaterial({ map: tex, roughness: 0.95 });
    const m = new THREE.Mesh(new THREE.PlaneGeometry(len, ROAD_W), mat);
    m.rotation.set(-Math.PI / 2, 0, Math.PI / 2);
    m.position.set(i*CELL, 0.02, (z1+z2)/2);
    m.receiveShadow = true;
    scene.add(m);
    generatedRoads.set(key, { mesh: m });
}

function addBuilding(group, x, z, w, h, d, isHouse, colliders) {
    const geoCopy = getBoxGeo(w, h, d).clone();
    const uv = geoCopy.attributes.uv;
    const scaleFace = (start, su, sv) => {
        for (let i = start; i < start + 4; i++) uv.setXY(i, uv.getX(i)*su, uv.getY(i)*sv);
    };
    scaleFace(0,  d/TILE, h/TILE);
    scaleFace(4,  d/TILE, h/TILE);
    scaleFace(16, w/TILE, h/TILE);
    scaleFace(20, w/TILE, h/TILE);
    uv.needsUpdate = true;
    const mat = isHouse
        ? houseMats[Math.floor(Math.random()*houseMats.length)]
        : facadeMats[Math.floor(Math.random()*facadeMats.length)];
    const mesh = new THREE.Mesh(geoCopy, mat);
    mesh.position.set(x, CURB_H + h/2, z);
    mesh.castShadow = true;
    mesh.receiveShadow = true;
    group.add(mesh);
    colliders.push({ minX: x - w/2, maxX: x + w/2, minZ: z - d/2, maxZ: z + d/2 });
}

