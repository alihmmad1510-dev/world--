function loadSocketIO() {
    return new Promise((resolve, reject) => {
        if (window.io) { resolve(); return; }
        const script = document.createElement('script');
        script.src = SERVER_URL.replace(/\/$/, '') + '/socket.io/socket.io.js';
        script.async = true;
        const to = setTimeout(() => { script.remove(); reject(new Error('TIMEOUT')); }, 6000);
        script.onload = () => { clearTimeout(to); resolve(); };
        script.onerror = () => { clearTimeout(to); reject(new Error('LOAD_FAILED')); };
        document.head.appendChild(script);
    });
}

function initSocket() {
    try {
        socket = window.io(SERVER_URL, {
            transports: ['websocket', 'polling'],
            reconnection: true,
            reconnectionAttempts: Infinity,
            reconnectionDelay: 1500,
            timeout: 15000,
            withCredentials: false
        });

        socket.on('connect', () => {
            console.log('[SOCKET] Connected:', socket.id);
            mp.connected = true;
            setMpStatus('متصل بالسيرفر ✔', 'connected');
            showNetStatus(!!mp.roomCode, mp.roomCode ? ('في غرفة ' + mp.roomCode) : 'متصل', false);
        });
        socket.on('disconnect', () => {
            mp.connected = false;
            setMpStatus('انقطع الاتصال', 'error');
            showNetStatus(true, 'انقطع الاتصال', true);
        });
        socket.on('connect_error', () => {
            mp.connected = false;
            setMpStatus('تعذّر الوصول للسيرفر', 'error');
        });

        socket.on('roomCreated', (data) => {
            if (!data.ok) return;
            mp.roomCode = data.code;
            mp.isHost = true;
            setMpStatus('الغرفة جاهزة — شارك الكود', 'host');
            updateRoomUI();
            updatePlayersList();
            showNetStatus(true, 'المضيف — ' + data.code, false);
        });
        socket.on('roomJoined', (data) => {
            if (!data.ok) return;
            mp.roomCode = data.code;
            mp.isHost = false;
            setMpStatus('انضممت للغرفة ✔', 'connected');
            (data.players || []).forEach(p => createRemotePlayer(p.id, p.shirt, p.pants));
            updateRoomUI();
            updatePlayersList();
            showNetStatus(true, 'في غرفة ' + data.code, false);
            broadcastState();
        });
        socket.on('joinError', (data) => {
            const msg = data.error === 'ROOM_NOT_FOUND' ? 'الغرفة غير موجودة'
                      : data.error === 'ROOM_FULL'      ? 'الغرفة ممتلئة'
                      : 'فشل الانضمام';
            setMpStatus(msg, 'error');
        });
        socket.on('playerJoined', (p) => {
            createRemotePlayer(p.id, p.shirt, p.pants);
            updatePlayersList();
        });
        socket.on('playerLeft', ({ id }) => {
            const rp = mp.remotePlayers.get(id);
            if (rp) { scene.remove(rp.group); mp.remotePlayers.delete(id); }
            const rc = remoteCars.get(id);
            if (rc) { scene.remove(rc); remoteCars.delete(id); }
            updatePlayersList();
        });
        socket.on('playerState', (p) => {
            let rp = mp.remotePlayers.get(p.id);
            if (!rp) rp = createRemotePlayer(p.id, p.shirt, p.pants);
            if (p.shirt !== undefined) rp.group.userData.shirtMat.color.setHex(p.shirt);
            if (p.pants !== undefined) rp.group.userData.pantsMat.color.setHex(p.pants);
            rp.targetPos.set(p.x, p.y, p.z);
            rp.targetRot = p.rot;
            rp.inCar = p.inCar;
            if (p.inCar) {
                let car = remoteCars.get(p.id);
                if (!car) {
                    car = createCarModel(0xc0392b);
                    scene.add(car);
                    remoteCars.set(p.id, car);
                }
                car.visible = true;
                car.position.set(p.cx, p.cy + 0.02, p.cz);
                car.rotation.y = p.crot;
                rp.group.visible = false;
            } else {
                rp.group.visible = true;
                const car = remoteCars.get(p.id);
                if (car) car.visible = false;
            }
        });
    } catch (e) {
        console.warn('[SOCKET] Init failed:', e);
        setMpStatus('تعذّر تشغيل الاتصال', 'error');
    }
}

