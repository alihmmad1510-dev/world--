function genBlock(i, j) {
    const key = `${i},${j}`;
    if (generatedBlocks.has(key)) return;

    const group = new THREE.Group();
    const cx = (i + 0.5) * CELL;
    const cz = (j + 0.5) * CELL;

    const sw = new THREE.Mesh(SIDEWALK_GEO, sidewalkMat);
    sw.position.set(cx, CURB_H/2, cz);
    sw.receiveShadow = true;
    group.add(sw);

    const colliders = [];

    if (i === PARK_BLOCK.i && j === PARK_BLOCK.j) buildParkInto(group, cx, cz);
    else if (i === DEALER_BLOCK.i && j === DEALER_BLOCK.j) buildDealershipInto(group, cx, cz);
    else if (i === HOME_BLOCK.i && j === HOME_BLOCK.j) buildHomeInto(group, cx, cz, colliders);
    else {
        const layout = pickLayout();
        layout.items.forEach(b => {
            const h = b.h[0] + Math.random() * (b.h[1] - b.h[0]);
            addBuilding(group, cx + b.x, cz + b.z, b.w, h, b.d, b.house, colliders);
        });
    }

    scene.add(group);
    generatedBlocks.set(key, { group, colliders, i, j });
}

function genStreetLight() {
    const g = new THREE.Group();
    const pole = new THREE.Mesh(new THREE.CylinderGeometry(0.13, 0.18, 7.2, 8), metalMat);
    pole.position.y = 3.6; pole.castShadow = true; g.add(pole);
    const arm = new THREE.Mesh(new THREE.BoxGeometry(2.4, 0.14, 0.14), metalMat);
    arm.position.set(1.2, 7.05, 0); g.add(arm);
    const head = new THREE.Mesh(new THREE.BoxGeometry(1.1, 0.22, 0.55), lampHeadMat);
    head.position.set(2.35, 6.9, 0); g.add(head);
    const bulb = new THREE.Mesh(new THREE.SphereGeometry(0.22, 10, 8), lampBulbMat);
    bulb.position.set(2.35, 6.75, 0); g.add(bulb);
    return g;
}

function genStreetLightsForBlock(i, j) {
    const key = `sl_${i}_${j}`;
    if (streetLights.has(key)) return;
    const group = new THREE.Group();
    const cx = (i + 0.5) * CELL;
    const cz = (j + 0.5) * CELL;
    const off = 20;
    [[-1,-1,0], [1,1,Math.PI]].forEach(([dx, dz, rot]) => {
        const sl = genStreetLight();
        sl.position.set(cx + dx*off, CURB_H, cz + dz*off);
        sl.rotation.y = rot;
        group.add(sl);
    });
    scene.add(group);
    streetLights.set(key, { group, i, j });
}

function updateCityAround(px, pz) {
    const pi = Math.round(px / CELL - 0.5);
    const pj = Math.round(pz / CELL - 0.5);

    for (let i = pi - RENDER_R; i <= pi + RENDER_R; i++)
        for (let j = pj - RENDER_R; j <= pj + RENDER_R; j++) {
            genBlock(i, j);
            genStreetLightsForBlock(i, j);
        }

    for (let i = pi - RENDER_R; i <= pi + RENDER_R; i++) {
        for (let j = pj - RENDER_R; j <= pj + RENDER_R; j++) {
            genIntersection(i, j); genRoadH(i, j); genRoadV(i, j);
        }
        genIntersection(i, pj + RENDER_R + 1);
        genRoadH(i, pj + RENDER_R + 1);
        genRoadV(i, pj + RENDER_R + 1);
    }
    for (let j = pj - RENDER_R; j <= pj + RENDER_R + 1; j++) {
        genIntersection(pi + RENDER_R + 1, j);
        genRoadH(pi + RENDER_R + 1, j);
        genRoadV(pi + RENDER_R + 1, j);
    }

    const removeKeys = [];
    generatedBlocks.forEach((b, k) => {
        if (Math.abs(b.i - pi) > RENDER_R + 1 || Math.abs(b.j - pj) > RENDER_R + 1) {
            scene.remove(b.group); removeKeys.push(k);
        }
    });
    removeKeys.forEach(k => generatedBlocks.delete(k));

    const removeRoads = [];
    generatedRoads.forEach((r, k) => {
        const parts = k.split('_');
        const ri = parseInt(parts[1], 10);
        const rj = parseInt(parts[2], 10);
        if (Math.abs(ri - pi) > RENDER_R + 2 || Math.abs(rj - pj) > RENDER_R + 2) {
            scene.remove(r.mesh); r.mesh.geometry.dispose(); removeRoads.push(k);
        }
    });
    removeRoads.forEach(k => generatedRoads.delete(k));

    const removeX = [];
    generatedIntersections.forEach((r, k) => {
        const parts = k.split('_');
        const ri = parseInt(parts[1], 10);
        const rj = parseInt(parts[2], 10);
        if (Math.abs(ri - pi) > RENDER_R + 2 || Math.abs(rj - pj) > RENDER_R + 2) {
            scene.remove(r.mesh); r.mesh.geometry.dispose(); removeX.push(k);
        }
    });
    removeX.forEach(k => generatedIntersections.delete(k));

    const removeLights = [];
    streetLights.forEach((sl, k) => {
        if (Math.abs(sl.i - pi) > RENDER_R + 1 || Math.abs(sl.j - pj) > RENDER_R + 1) {
            scene.remove(sl.group); removeLights.push(k);
        }
    });
    removeLights.forEach(k => streetLights.delete(k));
}

