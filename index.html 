    const eM = eyeMaterial || playerEyeMat;

    const g = new THREE.Group();

    const t = new THREE.Mesh(new THREE.BoxGeometry(0.72, 0.82, 0.40), shirtMaterial);
    t.position.y = 1.28; t.castShadow = true; g.add(t);
    const h = new THREE.Mesh(new THREE.BoxGeometry(0.68, 0.32, 0.38), pantsMaterial);
    h.position.y = 0.83; h.castShadow = true; g.add(h);
    const n = new THREE.Mesh(new THREE.CylinderGeometry(0.1, 0.12, 0.14, 8), sM);
    n.position.y = 1.74; g.add(n);
    const hd = new THREE.Mesh(new THREE.SphereGeometry(0.23, 16, 12), sM);
    hd.position.y = 1.95; hd.castShadow = true; g.add(hd);

    const eyeL = new THREE.Mesh(new THREE.SphereGeometry(0.03, 8, 6), eM);
    eyeL.position.set(-0.08, 1.97, 0.20); g.add(eyeL);
    const eyeR = new THREE.Mesh(new THREE.SphereGeometry(0.03, 8, 6), eM);
    eyeR.position.set(0.08, 1.97, 0.20); g.add(eyeR);

    const hr = new THREE.Mesh(
        new THREE.SphereGeometry(0.24, 16, 12, 0, Math.PI*2, 0, Math.PI*0.62),
        hM);
    hr.position.y = 1.97; g.add(hr);

    function mkArm(side) {
        const pivot = new THREE.Group();
        pivot.position.set(side * 0.47, 1.62, 0);
        const upper = new THREE.Mesh(new THREE.BoxGeometry(0.18, 0.64, 0.18), shirtMaterial);
        upper.position.y = -0.32; upper.castShadow = true; pivot.add(upper);
        const hand = new THREE.Mesh(new THREE.SphereGeometry(0.10, 10, 8), sM);
        hand.position.y = -0.70; hand.castShadow = true; pivot.add(hand);
        return pivot;
    }
    function mkLeg(side) {
        const pivot = new THREE.Group();
        pivot.position.set(side * 0.18, 0.84, 0);
        const upper = new THREE.Mesh(new THREE.BoxGeometry(0.25, 0.76, 0.25), pantsMaterial);
        upper.position.y = -0.38; upper.castShadow = true; pivot.add(upper);
        const foot = new THREE.Mesh(new THREE.BoxGeometry(0.27, 0.13, 0.42), shoeMat);
        foot.position.set(0, -0.79, 0.08); foot.castShadow = true; pivot.add(foot);
        return pivot;
    }
    const aL = mkArm(-1), aR = mkArm(1);
    const lL = mkLeg(-1), lR = mkLeg(1);
    g.add(aL, aR, lL, lR);

    g.userData = {
        shirtMat: shirtMaterial,
        pantsMat: pantsMaterial,
        skinMat: sM,
        hairMat: hM,
        eyeMat: eM,
        armL: aL, armR: aR, legL: lL, legR: lR
    };
    return g;
}

