    if (!/^[A-Z0-9]{6}$/.test(code)) {
        setMpStatus('الكود غير صحيح', 'error');
        return;
    }
    setMpStatus('جارٍ الاتصال...', '');
    socket.emit('joinRoom', {
        code,
        playerInfo: {
            shirt: OUTFITS[currentOutfit].shirt,
            pants: OUTFITS[currentOutfit].pants
        }
    });
});

document.getElementById('mp-disconnect').addEventListener('click', () => {
    if (socket && socket.connected) socket.emit('leaveRoom');
    mp.remotePlayers.forEach(rp => scene.remove(rp.group));
    mp.remotePlayers.clear();
    remoteCars.forEach(c => scene.remove(c));
    remoteCars.clear();
    mp.roomCode = '';
    mp.isHost = false;
    setMpStatus('غير متصل', '');
    updateRoomUI();
    updatePlayersList();
    showNetStatus(false);
});

btnOnline.addEventListener('click', (e) => {
    e.preventDefault(); e.stopPropagation();
    openMpPanel();
});
document.getElementById('mp-close').addEventListener('click', closeMpPanel);
mpPanel.addEventListener('click', (e) => { if (e.target === mpPanel) closeMpPanel(); });
btnOnline.addEventListener('contextmenu', e => e.preventDefault());

document.getElementById('mp-copy').addEventListener('click', async () => {
    const btn = document.getElementById('mp-copy');
    try {
        await navigator.clipboard.writeText(mp.roomCode);
        btn.textContent = '✔ تم';
        setTimeout(() => { btn.textContent = '📋 نسخ'; }, 1500);
    } catch {
        btn.textContent = '⚠️';
        setTimeout(() => { btn.textContent = '📋 نسخ'; }, 1500);
    }
});

mpCodeInput.addEventListener('input', () => {
    mpCodeInput.value = mpCodeInput.value.toUpperCase().replace(/[^A-Z0-9]/g, '');
});
mpCodeInput.addEventListener('keydown', (e) => {
    if (e.key === 'Enter') { e.preventDefault(); document.getElementById('mp-join').click(); }
});

function broadcastState() {
    if (!socket || !socket.connected || !mp.roomCode) return;
    socket.emit('playerState', {
        x: player.position.x,
        y: player.position.y,
        z: player.position.z,
        rot: player.rotation.y,
        inCar: inCar,
        cx: playerCar.position.x,
        cy: playerCar.position.y,
        cz: playerCar.position.z,
        crot: playerCar.rotation.y,
        shirt: OUTFITS[currentOutfit].shirt,
        pants: OUTFITS[currentOutfit].pants
    });
}

function createRemotePlayer(pid, shirtColor, pantsColor) {
    const sM = new THREE.MeshStandardMaterial({ color: shirtColor, roughness: 0.75 });
    const pM = new THREE.MeshStandardMaterial({ color: pantsColor, roughness: 0.95 });
    const group = buildCharacterMesh(sM, pM);
    group.position.set(0, CURB_H, 0);
    scene.add(group);
    const rp = {
        group,
        targetPos: new THREE.Vector3(),
        currentPos: new THREE.Vector3(),
        targetRot: 0,
        currentRot: 0,
        inCar: false
    };
    mp.remotePlayers.set(pid, rp);
    return rp;
}

updateRoomUI();
updatePlayersList();

/* ============================================================
   التحكم
   ============================================================ */
const keys = { forward: false, backward: false, left: false, right: false, run: false };
let yaw = 0, pitch = -0.06;
const PITCH_MIN = -0.85, PITCH_MAX = 0.85;

document.addEventListener('keydown', (e) => {
    if (e.target && e.target.tagName === 'INPUT') return;

    if (mpPanelOpen) {
        if (e.code === 'Escape') closeMpPanel();
        return;
    }
    if (wardrobeOpen) {
        if (e.code === 'Escape' || e.code === 'Enter' || e.code === 'Space' || e.code === 'KeyE') {
            closeWardrobe(); e.preventDefault();
        }
        return;
    }
    switch (e.code) {
        case 'KeyW': case 'ArrowUp':    keys.forward  = true; break;
        case 'KeyS': case 'ArrowDown':  keys.backward = true; break;
        case 'KeyA': case 'ArrowLeft':  keys.left     = true; break;
        case 'KeyD': case 'ArrowRight': keys.right    = true; break;
        case 'ShiftLeft': case 'ShiftRight': keys.run = true; break;
        case 'Space': e.preventDefault(); onEnterPressed(); break;
        case 'KeyE': onEnterPressed(); break;
    }
});
document.addEventListener('keyup', (e) => {
    switch (e.code) {
        case 'KeyW': case 'ArrowUp':    keys.forward  = false; break;
        case 'KeyS': case 'ArrowDown':  keys.backward = false; break;
        case 'KeyA': case 'ArrowLeft':  keys.left     = false; break;
        case 'KeyD': case 'ArrowRight': keys.right    = false; break;
        case 'ShiftLeft': case 'ShiftRight': keys.run = false; break;
    }
});

const joyEl = document.getElementById('joystick');
const stickEl = document.getElementById('stick');
const joyInput = { x: 0, y: 0 };
let joyPointerId = null;

function joyMaxRadius() {
    const r = joyEl.getBoundingClientRect();
    return Math.max(20, r.width/2 - 12);
}
function joyUpdate(clientX, clientY) {
    const r = joyEl.getBoundingClientRect();
    const cx = r.left + r.width/2, cy = r.top + r.height/2;
    let dx = clientX - cx, dy = clientY - cy;
    const max = joyMaxRadius();
    const dist = Math.hypot(dx, dy);
    if (dist > max) { dx = (dx/dist)*max; dy = (dy/dist)*max; }
    stickEl.style.transform = `translate(calc(-50% + ${dx}px), calc(-50% + ${dy}px))`;
    joyInput.x = dx / max;
    joyInput.y = dy / max;
}
function joyReset() {
    joyPointerId = null;
    joyInput.x = 0; joyInput.y = 0;
    stickEl.style.transform = 'translate(-50%, -50%)';
}
joyEl.addEventListener('pointerdown', (e) => {
    if (wardrobeOpen || mpPanelOpen) return;
    if (joyPointerId !== null) return;
    joyPointerId = e.pointerId;
    joyEl.setPointerCapture(e.pointerId);
    joyUpdate(e.clientX, e.clientY);
    e.preventDefault();
});
joyEl.addEventListener('pointermove', (e) => {
    if (e.pointerId !== joyPointerId) return;
    joyUpdate(e.clientX, e.clientY);
    e.preventDefault();
});
joyEl.addEventListener('pointerup', (e) => { if (e.pointerId === joyPointerId) joyReset(); });
joyEl.addEventListener('pointercancel', (e) => { if (e.pointerId === joyPointerId) joyReset(); });
joyEl.addEventListener('lostpointercapture', () => { if (joyPointerId !== null) joyReset(); });

const LOOK_SENS = 0.0042;
let lookPointerId = null, lookX = 0, lookY = 0;

renderer.domElement.addEventListener('pointerdown', (e) => {
    if (wardrobeOpen || mpPanelOpen) return;
    if (lookPointerId !== null) return;
    lookPointerId = e.pointerId;
    lookX = e.clientX; lookY = e.clientY;
    renderer.domElement.setPointerCapture(e.pointerId);
});
renderer.domElement.addEventListener('pointermove', (e) => {
    if (e.pointerId !== lookPointerId) return;
    yaw   -= (e.clientX - lookX) * LOOK_SENS;
    pitch -= (e.clientY - lookY) * LOOK_SENS;
    pitch = Math.max(PITCH_MIN, Math.min(PITCH_MAX, pitch));
    lookX = e.clientX; lookY = e.clientY;
});
function endLook(e) { if (e.pointerId === lookPointerId) lookPointerId = null; }
renderer.domElement.addEventListener('pointerup', endLook);
renderer.domElement.addEventListener('pointercancel', endLook);
renderer.domElement.addEventListener('lostpointercapture', endLook);

const btnEnter = document.getElementById('btn-enter');
btnEnter.addEventListener('pointerdown', (e) => {
    e.preventDefault();
    btnEnter.classList.add('pressed');
    btnEnter.setPointerCapture(e.pointerId);
    onEnterPressed();
});
btnEnter.addEventListener('pointerup', () => btnEnter.classList.remove('pressed'));
btnEnter.addEventListener('pointercancel', () => btnEnter.classList.remove('pressed'));
btnEnter.addEventListener('contextmenu', e => e.preventDefault());

/* ============================================================
   التفاعل
   ============================================================ */
let inCar = false;
const promptEl = document.getElementById('prompt');
const promptText = document.getElementById('prompt-text');

function distance2D(a, b) {
    const dx = a.x - b.x, dz = a.z - b.z;
    return Math.sqrt(dx*dx + dz*dz);
}
function nearPlayerCar() { return distance2D(player.position, playerCar.position) < 4; }
function nearHomeDoor() { return distance2D(player.position, HOME_DOOR_POS) < 3.5; }

function onEnterPressed() {
    if (wardrobeOpen) { closeWardrobe(); return; }
    if (mpPanelOpen) { closeMpPanel(); return; }
    if (inCar) { exitCar(); return; }
    if (nearHomeDoor()) { openWardrobe(); return; }
    if (nearPlayerCar()) { enterCar(); return; }
    if (isGrounded) { yVel = JUMP_V; isGrounded = false; }
}
function enterCar() {
    inCar = true;
    player.visible = false;
    carState.heading = playerCar.rotation.y;
    carState.speed = 0;
    broadcastState();
}
function exitCar() {
    inCar = false;
    player.visible = true;
    const h = carState.heading;
    const leftX = Math.cos(h), leftZ = -Math.sin(h);
    const exitX = playerCar.position.x + leftX * 2.2;
    const exitZ = playerCar.position.z + leftZ * 2.2;
    const exitY = groundHeightAt(exitX, exitZ);
    player.position.set(exitX, exitY, exitZ);
    player.rotation.y = h;
    yaw = h + Math.PI;
    broadcastState();
}

/* ============================================================
   الفيزياء
   ============================================================ */
let yVel = 0, isGrounded = true;
const GRAVITY = -32;
const JUMP_V = 11;
const WALK_SPD = 16;
const RUN_SPD = 32;
const PLAYER_R = 0.55;
const CAR_R = 1.5;

function groundHeightAt(x, z) {
    const fx = (x - 8) / CELL;
    const fz = (z - 8) / CELL;
    const i = Math.floor(fx), j = Math.floor(fz);
    const lx = x - (i*CELL + 8), lz = z - (j*CELL + 8);
    if (lx >= 0 && lx < 40 && lz >= 0 && lz < 40) return CURB_H;
    return 0;
}
function hitsBuilding(x, z, radius) {
    const bi = Math.round(x / CELL - 0.5);
    const bj = Math.round(z / CELL - 0.5);
    for (let di = -1; di <= 1; di++) {
        for (let dj = -1; dj <= 1; dj++) {
            const blk = generatedBlocks.get(`${bi+di},${bj+dj}`);
            if (!blk) continue;
            for (const b of blk.colliders) {
                if (x > b.minX - radius && x < b.maxX + radius &&
                    z > b.minZ - radius && z < b.maxZ + radius) return true;
            }
        }
    }
    return false;
}

/* ============================================================
   حلقة الرسم
   ============================================================ */
const clock = new THREE.Clock();
const camTarget = new THREE.Vector3();
const camOffset = new THREE.Vector3();
const forwardDir = new THREE.Vector3();
const rightDir = new THREE.Vector3();
const moveDir = new THREE.Vector3();
const Y_AXIS = new THREE.Vector3(0, 1, 0);

const CAM_DIST = 6.5;
const CAM_HEIGHT = 2.6;
let walkPhase = 0;
let lastCityI = null, lastCityJ = null;

function animate() {
    requestAnimationFrame(animate);
    const delta = Math.min(clock.getDelta(), 0.05);

    const focusX = inCar ? playerCar.position.x : player.position.x;
    const focusZ = inCar ? playerCar.position.z : player.position.z;
    const ci = Math.round(focusX / CELL - 0.5);
    const cj = Math.round(focusZ / CELL - 0.5);
    if (ci !== lastCityI || cj !== lastCityJ) {
        updateCityAround(focusX, focusZ);
        lastCityI = ci; lastCityJ = cj;
    }

    updateDayNight(delta, focusX, focusZ);

    const uiBlocking = wardrobeOpen || mpPanelOpen;

    if (inCar && !uiBlocking) {
        let throttle = (keys.forward ? 1 : 0) - (keys.backward ? 1 : 0);
        let steer = (keys.right ? 1 : 0) - (keys.left ? 1 : 0);
        const jy = -joyInput.y, jx = joyInput.x;
        if (Math.abs(jy) > 0.15) throttle += jy;
        if (Math.abs(jx) > 0.15) steer += jx;
        throttle = Math.max(-1, Math.min(1, throttle));
        steer = Math.max(-1, Math.min(1, steer));

        if (throttle > 0.05) carState.speed += carState.accel * throttle * delta;
        else if (throttle < -0.05) carState.speed += carState.accel * throttle * 1.2 * delta;
        else { carState.speed *= (1 - 1.8 * delta); if (Math.abs(carState.speed) < 0.2) carState.speed = 0; }
        carState.speed = Math.max(-carState.reverseSpeed, Math.min(carState.maxSpeed, carState.speed));

        if (Math.abs(carState.speed) > 0.4) {
            const dirSign = Math.sign(carState.speed);
            carState.heading -= steer * carState.turnRate * delta * dirSign;
        }

        const vx = Math.sin(carState.heading) * carState.speed * delta;
        const vz = Math.cos(carState.heading) * carState.speed * delta;
        const nx = playerCar.position.x + vx;
        const nz = playerCar.position.z + vz;
        if (!hitsBuilding(nx, playerCar.position.z, CAR_R)) playerCar.position.x = nx; else carState.speed *= 0.3;
        if (!hitsBuilding(playerCar.position.x, nz, CAR_R)) playerCar.position.z = nz; else carState.speed *= 0.3;

        const gY = groundHeightAt(playerCar.position.x, playerCar.position.z);
        playerCar.position.y = gY + 0.02;
        playerCar.rotation.y = carState.heading;
        yaw = carState.heading + Math.PI;

        camTarget.set(playerCar.position.x, playerCar.position.y + 1.7, playerCar.position.z);
        const cosP = Math.cos(pitch);
        const dist = CAM_DIST + 1.5 + Math.abs(carState.speed) * 0.06;
        camOffset.set(
            Math.sin(yaw) * cosP * dist,
            Math.sin(pitch) * dist + CAM_HEIGHT + 0.4,
            Math.cos(yaw) * cosP * dist
        );
        camera.position.copy(camTarget).add(camOffset);
        if (camera.position.y < 0.6) camera.position.y = 0.6;
        camera.lookAt(camTarget);
    } else {
        if (!uiBlocking) {
            forwardDir.set(0, 0, -1).applyAxisAngle(Y_AXIS, yaw);
            rightDir.set(1, 0, 0).applyAxisAngle(Y_AXIS, yaw);

            let axRight = (keys.right ? 1 : 0) - (keys.left ? 1 : 0);
            let axFwd   = (keys.forward ? 1 : 0) - (keys.backward ? 1 : 0);
            let jx = joyInput.x, jy = joyInput.y;
            if (Math.hypot(jx, jy) < 0.14) { jx = 0; jy = 0; }
            axRight += jx; axFwd -= jy;
            let mag = Math.hypot(axRight, axFwd);
            if (mag > 1) { axRight /= mag; axFwd /= mag; mag = 1; }

            moveDir.set(0, 0, 0);
            moveDir.addScaledVector(forwardDir, axFwd);
            moveDir.addScaledVector(rightDir, axRight);

            const isMoving = mag > 0.03;
            const speed = (keys.run ? RUN_SPD : WALK_SPD) * mag;

            if (isMoving) {
                moveDir.normalize();
                const nx = player.position.x + moveDir.x * speed * delta;
                const nz = player.position.z + moveDir.z * speed * delta;
                if (!hitsBuilding(nx, player.position.z, PLAYER_R)) player.position.x = nx;
                if (!hitsBuilding(player.position.x, nz, PLAYER_R)) player.position.z = nz;
                const targetRot = Math.atan2(moveDir.x, moveDir.z);
                let diff = targetRot - player.rotation.y;
                while (diff > Math.PI) diff -= Math.PI * 2;
                while (diff < -Math.PI) diff += Math.PI * 2;
                player.rotation.y += diff * Math.min(1, delta * 12);
            }

            const groundY = groundHeightAt(player.position.x, player.position.z);
            yVel += GRAVITY * delta;
            player.position.y += yVel * delta;
            if (player.position.y <= groundY) { player.position.y = groundY; yVel = 0; isGrounded = true; }

            if (isMoving) walkPhase += delta * (speed * 0.55 + 2.0);
            else walkPhase += delta * 2.2;

            const amp = isMoving ? (keys.run ? 0.95 : 0.62) * mag : 0.0;
            const legSwing = Math.sin(walkPhase) * amp;
            const armSwing = Math.sin(walkPhase) * amp * 0.8;
            legL.rotation.x = legSwing;
            legR.rotation.x = -legSwing;
            armL.rotation.x = -armSwing;
            armR.rotation.x = armSwing;
        }

        camTarget.set(player.position.x, player.position.y + 1.6, player.position.z);
        const cosP = Math.cos(pitch);
        camOffset.set(
            Math.sin(yaw) * cosP * CAM_DIST,
            Math.sin(pitch) * CAM_DIST + CAM_HEIGHT,
            Math.cos(yaw) * cosP * CAM_DIST
        );
        camera.position.copy(camTarget).add(camOffset);
        if (camera.position.y < 0.6) camera.position.y = 0.6;
        camera.lookAt(camTarget);
    }

    sky.position.copy(camera.position);

    /* سيارات المرور */
    aiCars.forEach(car => {
        const u = car.userData;
        u.pos += u.dir * u.speed * delta;
        const tooFar = (u.axis === 'x' && Math.abs(car.position.x - player.position.x) > 280) ||
                       (u.axis === 'z' && Math.abs(car.position.z - player.position.z) > 280);
        if (u.pos < u.minPos || u.pos > u.maxPos || tooFar) { assignCarPath(car); return; }
        if (u.axis === 'x') car.position.x = u.pos;
        else car.position.z = u.pos;
    });

    /* المشاة */
    pedestrians.forEach(p => {
        const u = p.userData;
        if (!u) return;
        u.t += u.speed * delta;
        if (u.t >= 1) { assignPedTarget(p); u.t = 0; return; }
        const pos = u.start.clone().lerp(u.end, u.t);
        p.position.copy(pos);
        const dir = u.end.clone().sub(u.start).normalize();
        const targetRot = Math.atan2(dir.x, dir.z);
        let diff = targetRot - p.rotation.y;
        while (diff > Math.PI) diff -= Math.PI * 2;
        while (diff < -Math.PI) diff += Math.PI * 2;
        p.rotation.y += diff * Math.min(1, delta * 6);
        u.phase += delta * 6;
        p.position.y = CURB_H + Math.abs(Math.sin(u.phase)) * 0.06;
        if (Math.abs(p.position.x - player.position.x) > 220 ||
            Math.abs(p.position.z - player.position.z) > 220) {
            assignPedTarget(p);
        }
    });

    /* اللاعبون البعيدون */
    mp.remotePlayers.forEach(rp => {
        rp.currentPos.lerp(rp.targetPos, Math.min(1, delta * 10));
        rp.group.position.copy(rp.currentPos);
        let diff = rp.targetRot - rp.currentRot;
        while (diff > Math.PI) diff -= Math.PI * 2;
        while (diff < -Math.PI) diff += Math.PI * 2;
        rp.currentRot += diff * Math.min(1, delta * 10);
        rp.group.rotation.y = rp.currentRot;

        if (rp.group.visible) {
            const moving = rp.currentPos.distanceTo(rp.targetPos) > 0.05;
            const amp = moving ? 0.6 : 0;
            const t = performance.now() * 0.008;
            const ud = rp.group.userData;
            ud.armL.rotation.x = -Math.sin(t) * amp * 0.8;
            ud.armR.rotation.x =  Math.sin(t) * amp * 0.8;
            ud.legL.rotation.x =  Math.sin(t) * amp;
            ud.legR.rotation.x = -Math.sin(t) * amp;
        }
    });

    /* إرسال الحالة */
    if (mp.connected && mp.roomCode) {
        mp.lastSyncTime += delta;
        if (mp.lastSyncTime >= mp.syncInterval) {
            mp.lastSyncTime = 0;
            broadcastState();
        }
    }

    /* نص التلميح */
    if (uiBlocking) promptEl.classList.remove('show');
    else if (inCar) {
        promptText.textContent = 'للخروج من العربية';
        promptEl.classList.add('show');
    } else if (nearHomeDoor()) {
        promptText.textContent = 'للدخول وتغيير الملابس';
        promptEl.classList.add('show');
    } else if (nearPlayerCar()) {
        promptText.textContent = 'لقيادة العربية';
        promptEl.classList.add('show');
    } else promptEl.classList.remove('show');

    renderer.render(scene, camera);
}

/* ============================================================
   تشغيل
   ============================================================ */
updateCityAround(player.position.x, player.position.z);
lastCityI = Math.round(player.position.x / CELL - 0.5);
lastCityJ = Math.round(player.position.z / CELL - 0.5);

window.addEventListener('resize', () => {
    camera.aspect = innerWidth / innerHeight;
    camera.updateProjectionMatrix();
    renderer.setSize(innerWidth, innerHeight);
});

window.addEventListener('beforeunload', () => {
    if (socket && socket.connected) socket.emit('leaveRoom');
});

animate();
</script>
