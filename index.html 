const joyEl = document.getElementById('joystick');
const stickEl = document.getElementById('stick');
const joyInput = { x: 0, y: 0 };
let joyPointerId = null;

function joyMaxRadius() {
    const r = joyEl.getBoundingClientRect();
    return Math.max(20, r.width/2 - 12);
}
function joyUpdate(clientX, clientY) {
    const r = joyEl.getBoundingClientRect();
    const cx = r.left + r.width/2, cy = r.top + r.height/2;
    let dx = clientX - cx, dy = clientY - cy;
    const max = joyMaxRadius();
    const dist = Math.hypot(dx, dy);
    if (dist > max) { dx = (dx/dist)*max; dy = (dy/dist)*max; }
    stickEl.style.transform = `translate(calc(-50% + ${dx}px), calc(-50% + ${dy}px))`;
    joyInput.x = dx / max;
    joyInput.y = dy / max;
}
function joyReset() {
    joyPointerId = null;
    joyInput.x = 0; joyInput.y = 0;
    stickEl.style.transform = 'translate(-50%, -50%)';
}
joyEl.addEventListener('pointerdown', (e) => {
    if (activePanel) return;
    if (joyPointerId !== null) return;
    joyPointerId = e.pointerId;
    joyEl.setPointerCapture(e.pointerId);
    joyUpdate(e.clientX, e.clientY);
    e.preventDefault();
});
joyEl.addEventListener('pointermove', (e) => {
    if (e.pointerId !== joyPointerId) return;
    joyUpdate(e.clientX, e.clientY);
    e.preventDefault();
});
joyEl.addEventListener('pointerup', (e) => { if (e.pointerId === joyPointerId) joyReset(); });
joyEl.addEventListener('pointercancel', (e) => { if (e.pointerId === joyPointerId) joyReset(); });
joyEl.addEventListener('lostpointercapture', () => { if (joyPointerId !== null) joyReset(); });

const LOOK_SENS = 0.0042;
let lookPointerId = null, lookX = 0, lookY = 0;

renderer.domElement.addEventListener('pointerdown', (e) => {
    if (activePanel) return;
    if (lookPointerId !== null) return;
    lookPointerId = e.pointerId;
    lookX = e.clientX; lookY = e.clientY;
    renderer.domElement.setPointerCapture(e.pointerId);
});
renderer.domElement.addEventListener('pointermove', (e) => {
    if (e.pointerId !== lookPointerId) return;
    yaw   -= (e.clientX - lookX) * LOOK_SENS;
    pitch -= (e.clientY - lookY) * LOOK_SENS;
    pitch = Math.max(PITCH_MIN, Math.min(PITCH_MAX, pitch));
    lookX = e.clientX; lookY = e.clientY;
});
function endLook(e) { if (e.pointerId === lookPointerId) lookPointerId = null; }
renderer.domElement.addEventListener('pointerup', endLook);
renderer.domElement.addEventListener('pointercancel', endLook);
renderer.domElement.addEventListener('lostpointercapture', endLook);

