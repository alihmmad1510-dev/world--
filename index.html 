const DAY_DURATION = 180;
let timeOfDay = 0.30;
const clockEl = document.getElementById('clock');

const C_NIGHT_TOP = new THREE.Color(0x05080f);
const C_NIGHT_MID = new THREE.Color(0x0a1220);
const C_NIGHT_BOT = new THREE.Color(0x141c28);
const C_DAWN_TOP  = new THREE.Color(0x2a3a6a);
const C_DAWN_MID  = new THREE.Color(0xd07050);
const C_DAWN_BOT  = new THREE.Color(0xf0a870);
const C_DAY_TOP   = new THREE.Color(0x1a5aa8);
const C_DAY_MID   = new THREE.Color(0x5f9fd4);
const C_DAY_BOT   = new THREE.Color(0xdfe9f2);

const tmpTop = new THREE.Color(), tmpMid = new THREE.Color(), tmpBot = new THREE.Color();

function updateDayNight(dt, focusX, focusZ) {
    timeOfDay = (timeOfDay + dt / DAY_DURATION) % 1.0;
    const sunAngle = (timeOfDay - 0.25) * Math.PI * 2;
    const sunY = Math.sin(sunAngle);
    const sunX = Math.cos(sunAngle);

    sun.position.set(focusX + sunX * 180, Math.max(15, sunY * 200), focusZ + 40);
    sun.target.position.set(focusX, 0, focusZ);
    sun.target.updateMatrixWorld();

    const dayFactor = Math.max(0, Math.min(1, sunY * 1.6 + 0.15));
    sun.intensity = 0.08 + dayFactor * 2.6;
    hemi.intensity = 0.12 + dayFactor * 1.05;
    ambient.intensity = 0.08 + dayFactor * 0.32;

    if (sunY < -0.12) { tmpTop.copy(C_NIGHT_TOP); tmpMid.copy(C_NIGHT_MID); tmpBot.copy(C_NIGHT_BOT); }
    else if (sunY < 0.18) {
        const k = (sunY + 0.12) / 0.30;
        tmpTop.copy(C_NIGHT_TOP).lerp(C_DAWN_TOP, k);
        tmpMid.copy(C_NIGHT_MID).lerp(C_DAWN_MID, k);
        tmpBot.copy(C_NIGHT_BOT).lerp(C_DAWN_BOT, k);
    } else if (sunY < 0.45) {
        const k = (sunY - 0.18) / 0.27;
        tmpTop.copy(C_DAWN_TOP).lerp(C_DAY_TOP, k);
        tmpMid.copy(C_DAWN_MID).lerp(C_DAY_MID, k);
        tmpBot.copy(C_DAWN_BOT).lerp(C_DAY_BOT, k);
    } else { tmpTop.copy(C_DAY_TOP); tmpMid.copy(C_DAY_MID); tmpBot.copy(C_DAY_BOT); }

    skyUniforms.uTop.value.copy(tmpTop);
    skyUniforms.uMid.value.copy(tmpMid);
    skyUniforms.uBot.value.copy(tmpBot);
    scene.fog.color.copy(tmpMid);

    const lampPower = Math.max(0, 1 - dayFactor * 2.6);
    lampHeadMat.emissiveIntensity = 0.15 + lampPower * 1.8;
    lampBulbMat.emissiveIntensity = 0.15 + lampPower * 2.2;
    const glow = 0.35 + (1 - dayFactor) * 1.4;
    facadeMats.forEach(m => m.emissiveIntensity = glow);
    houseMats.forEach(m => m.emissiveIntensity = glow);

    const hours = Math.floor(((timeOfDay * 24) + 6) % 24);
    const minutes = Math.floor((((timeOfDay * 24) + 6) % 1) * 60);
    clockEl.innerHTML = `${String(hours).padStart(2,'0')}:${String(minutes).padStart(2,'0')} <span class="sun">${sunY > 0 ? '☀' : '🌙'}</span>`;
}

