const SIDEWALK_GEO = new THREE.BoxGeometry(40, CURB_H, 40);
const boxGeoCache = new Map();
function getBoxGeo(w, h, d) {
    const key = `${w}_${h}_${d}`;
    if (boxGeoCache.has(key)) return boxGeoCache.get(key);
    const g = new THREE.BoxGeometry(w, h, d);
    boxGeoCache.set(key, g);
    return g;
}

const generatedBlocks = new Map();
