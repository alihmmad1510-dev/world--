    if (r < 0.34) return { items: [
        { x: -8, z: 0, w: 14, d: 28, h: [14, 36], house: false },
        { x:  8, z: 0, w: 14, d: 28, h: [14, 36], house: false }
    ]};
    if (r < 0.52) return { items: [
        { x: -8, z: 0, w: 7, d: 14, h: [4, 8], house: false },
        { x:  0, z: 0, w: 7, d: 14, h: [4, 8], house: false },
        { x:  8, z: 0, w: 7, d: 14, h: [4, 8], house: false }
    ]};
    if (r < 0.72) return { items: [
        { x: -9, z: -9, w: 13, d: 13, h: [5, 9], house: true },
        { x:  9, z: -9, w: 13, d: 13, h: [5, 9], house: true },
